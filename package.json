{
  "name": "sportshop",
  "version": "1.0.0",
  "description": "SportShop (ASP.NET Core MVC + SQLite, frontend HTML/CSS/JavaScript)",
  "scripts": {
    "start": "dotnet run --project backend\\SportShop.Mvc\\SportShop.Mvc.csproj",
    "dev": "dotnet watch --project backend\\SportShop.Mvc\\SportShop.Mvc.csproj",
    "test": "dotnet test backend\\SportShop.Mvc.Tests\\SportShop.Mvc.Tests.csproj",
    "test:node-legacy": "jest --runInBand",
    "products:add": "node database/themSanPhamMau.js",
    "db:init": "dotnet run --project backend\\SportShop.Mvc\\SportShop.Mvc.csproj -- --migrate-only",
    "db:seed": "dotnet run --project backend\\SportShop.Mvc\\SportShop.Mvc.csproj -- --seed-only"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "joi": "^17.13.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "license": "MIT",
  "jest": {
    "testRegex": "kiemThu/.*\\.test\\.js$",
    "setupFiles": [
      "<rootDir>/kiemThu/khoiTaoCSDL.setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/kiemThu/dongDepCSDL.setup.js"
    ]
  }
}
