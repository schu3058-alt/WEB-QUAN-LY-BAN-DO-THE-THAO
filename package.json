{
  "name": "sportshop",
  "version": "1.0.0",
  "description": "He thong quan ly ban do the thao SportShop (backend Node.js/Express + SQLite, frontend thuan HTML/CSS/JS)",
  "main": "backend/mayChu.js",
  "scripts": {
    "start": "node backend/mayChu.js",
    "dev": "nodemon backend/mayChu.js",
    "test": "jest --runInBand",
    "products:add": "node database/themSanPhamMau.js",
    "db:init": "node database/khoiTao.js",
    "db:seed": "node database/khoiTao.js --seed"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "joi": "^17.13.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "license": "MIT",
  "jest": {
    "testRegex": "kiemThu/.*\\.test\\.js$",
    "setupFiles": [
      "<rootDir>/kiemThu/khoiTaoCSDL.setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/kiemThu/dongDepCSDL.setup.js"
    ]
  }
}
